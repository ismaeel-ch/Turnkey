{
  "name": "turnkey",
  "version": "0.3.1",
  "private": true,
  "description": "Turnkey: describe the app your work needs and a team of agents builds its database, backend, views, pages and tests on a workflow you can watch and change.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-sqlite.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-sqlite.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "format": "prettier --write \"src/{app,platform,server,shared,workspace,styles}/**/*.{ts,tsx,css}\" \"tests/unit/**/*.ts\" \"scripts/*.mjs\" \"*.{json,md,mjs,ts}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/{app,platform,server,shared,workspace,styles}/**/*.{ts,tsx,css}\" \"tests/unit/**/*.ts\" \"scripts/*.mjs\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm run test",
    "icons": "node scripts/gen-icons.cjs",
    "icons:pwa": "node scripts/gen-pwa-icons.mjs",
    "theme": "node scripts/generate-theme.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@ag-ui/encoder": "^1.0.5",
    "@ai-sdk/provider": "^3.0.19",
    "@copilotkit/react-core": "^1.90.2",
    "@copilotkit/runtime": "^1.90.2",
    "@fluentui/react-components": "^9.75.3",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@vercel/blob": "^2.9.0",
    "@xyflow/react": "12.12.1",
    "ai": "^6.0.338",
    "next": "16.4.6",
    "openai": "^7.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.1",
    "sql.js": "1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "undici": "^6.29.1",
    "vitest": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismaeel-ch/Turnkey.git"
  },
  "bugs": {
    "url": "https://github.com/ismaeel-ch/Turnkey/issues"
  },
  "homepage": "https://github.com/ismaeel-ch/Turnkey#readme"
}
