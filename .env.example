# Copy to .env.local for local work. On Vercel, set the same names under Settings → Environment Variables.
# Never commit a real key, never paste one into code, a README or a screenshot, and never use a NEXT_PUBLIC_ name.

# --- Claude API key (console.anthropic.com). The backend for the deployed site for now. ---
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL=claude-sonnet-5-5  ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Leave the key empty on your own machine to use the Claude Code command (your Claude login) instead.

# --- SSI LiteLLM gateway, for later. Used when its three settings are set and no Anthropic key is, or with
# LLM_PROVIDER=litellm. Names are the ones the hackathon guide asks for. ---
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=claude-sonnet-5-5
# LITELLM_MODEL_FAST=claude-haiku

# --- Or any OpenAI-compatible service ---
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional ---
# LLM_PROVIDER=mock            # run with a stand-in model: no key, no network, no cost
# LIVE_MODE=off                # refuse every model call; saved builds keep working
# LLM_DAILY_CALL_CAP=600       # see src/server/guard/limits.ts for the full list
